    "scenario": "node --env-file=.env src/scenario.ts",
    "all": "node --env-file=.env src/scenario.ts all",
    "cleanup": "node --env-file=.env src/cleanup.ts"
  },
  "dependencies": {
    "@azure/identity": "^4.14.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
