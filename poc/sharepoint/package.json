{
  "name": "mms-sharepoint-poc",
  "version": "0.1.0",
  "private": true,
  "description": "MMS SharePoint storage proof-of-concept (PoC_ lists on the MMS site; deleted after the test)",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "phase0": "node --env-file=.env src/phase0.ts",
