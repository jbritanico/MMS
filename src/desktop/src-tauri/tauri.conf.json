{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sprint MMS",
  "version": "0.9.0",
  "identifier": "com.sprintogs.mms",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sprint MMS",
        "width": 1180,
        "height": 1050,
        "minWidth": 960,
        "minHeight": 700,
        "maximized": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$RESOURCE/resources/maps/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "resources/beta-start.db": "resources/beta-start.db",
      "libs/libcrypto-3-x64.dll": "libcrypto-3-x64.dll",
      "resources/maps/test-region.pmtiles": "resources/maps/test-region.pmtiles",
      "libs/vcruntime140.dll": "vcruntime140.dll",
      "libs/vcruntime140_1.dll": "vcruntime140_1.dll"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
